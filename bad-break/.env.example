# ---- Match service (src/server) ----
# Port the WebSocket match service listens on.
BADBREAK_PORT=8787
# Host/interface to bind. Use 0.0.0.0 in containers.
BADBREAK_HOST=0.0.0.0
# Simulation ticks per second (authoritative fixed step). Default 60.
BADBREAK_TICK_RATE=60
# Authoritative snapshots per second sent to clients. Default 20.
BADBREAK_SNAPSHOT_RATE=20
# Seconds an empty room survives before cleanup. Default 120.
BADBREAK_ROOM_TTL_SECONDS=120
# Seconds a disconnected player may reconnect before forfeiting. Default 20.
BADBREAK_RECONNECT_GRACE_SECONDS=20
# Comma-separated allowed origins for WebSocket upgrades ("*" allows all).
BADBREAK_ALLOWED_ORIGINS=*

# ---- Client (Vite, must be prefixed VITE_) ----
# WebSocket URL of the match service as seen from the browser.
VITE_BADBREAK_SERVER_URL=ws://localhost:8787
